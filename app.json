{
  "expo": {
    "name": "crowdcue",
    "slug": "crowdcue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CrowdCue to access your photos so you can set a profile image."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow CrowdCue to access your photos so you can set a profile image.",
          "savePhotosPermission": "Allow CrowdCue to save your session QR code to Photos."
        }
      ]
    ],
    "scheme": "crowdcue",
    "experiments": {
      "typedRoutes": true
    }
  }
}
